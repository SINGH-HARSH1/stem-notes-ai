# Environment variables for Stem Notes AI application

# App Settings
# Add this to your .env
APP__NAME="STEM Notes AI"
APP__VERSION="0.1.0"
APP__ENV=local
APP__DEBUG=false
APP__LOG_LEVEL=INFO

# API Settings
API__PORT=8000

# Storage, Database and Broker Settings
# Below are sample Urls for the database and broker. Replace them with actual values.
DATABASE__URL=postgresql+asyncpg://stem_user:password@localhost:5432/stem_notes
BROKER__URL=redis://:myredispassword@localhost:6379/0

# Model Provider Settings
AI__OPENAI_API_KEY=sk-test_openai_api_key
AI__LLM_MODEL_NAME=gpt-4o
